<?xml version='1.0' encoding='utf-8'?>
<spec id="file.interface" file="INTERFACE.xml" type="interface" project="journal-entry-tests" version="0.2" status="decided">
  <invocations>
    <invocation id="inv.analyze">
      <purpose>Apply the five tests to a ledger and write results.xlsx.</purpose>
      <trigger>journal-entry-tests analyze LEDGER [--out-dir DIR] [--round-base N] [--holidays FILE] [--benford-min-rows N] [--overwrite]</trigger>
      <allowed_roles>user</allowed_roles>
      <navigation>No navigation; one command, one run.</navigation>
      <arguments>
        <argument name="LEDGER" required="true">Path of the input CSV.</argument>
        <argument name="--out-dir" default="out">Output folder; created if it does not exist.</argument>
        <argument name="--round-base" default="1000">Base for the round values test.</argument>
        <argument name="--holidays" default="none">Holidays CSV, one date per line.</argument>
        <argument name="--benford-min-rows" default="1000">Minimum number of rows for the Benford test.</argument>
        <argument name="--overwrite" default="false">Replace results.xlsx if it exists.</argument>
      </arguments>
      <actions_results>Writes results.xlsx and a final line on stdout; errors go to stderr.</actions_results>
      <responsive>Not applicable: command line.</responsive>
      <not_applicable kind="idle" reason="A command-line command has no idle state." />
      <not_applicable kind="loading" reason="Version 1 shows no progress." />
      <state id="state.analyze.empty" kind="empty">
        <description>Zero valid rows, including the case where every row is rejected: code 0, empty sheets and the empty message.</description>
      </state>
      <state id="state.analyze.success" kind="success">
        <description>Ends with code 0 and the final line.</description>
      </state>
      <state id="state.analyze.error" kind="error">
        <description>Short message on stderr with code 1 or 2.</description>
      </state>
      <state id="state.analyze.partial" kind="partial">
        <description>At least one valid row and at least one rejected row: code 0, Rejected rows sheet filled and the done message.</description>
      </state>
      <not_applicable kind="offline" reason="The tool always works without a network." />
      <state id="state.analyze.no_permission" kind="no_permission">
        <description>Output folder not writable: code 1.</description>
      </state>
    </invocation>
  </invocations>
  <screens>
    <screen id="screen.sheet_readme">
      <purpose>Explains the other sheets and shows the warning.</purpose>
      <route>Sheet of the results.xlsx file</route>
      <allowed_roles>user</allowed_roles>
      <navigation>Excel tabs.</navigation>
      <responsive>Fixed column widths, frozen header row; no breakpoints.</responsive>
      <not_applicable kind="idle" reason="Static sheet of a generated file." />
      <not_applicable kind="loading" reason="The file only opens after it is written." />
      <not_applicable kind="empty" reason="The content is always shown, even with zeros." />
      <state id="state.sheet_readme.success" kind="success">
        <description>Help text and warning.</description>
      </state>
      <not_applicable kind="error" reason="Errors happen before the file exists." />
      <not_applicable kind="partial" reason="The sheet is always complete." />
      <not_applicable kind="offline" reason="No network is used." />
      <not_applicable kind="no_permission" reason="No access control in the file." />
    </screen>
    <screen id="screen.sheet_summary">
