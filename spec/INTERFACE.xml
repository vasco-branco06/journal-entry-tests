    <screen id="screen.sheet_test">
      <purpose>Sheet of one test (Duplicates, Round values, Weekend and holiday, Numbering gaps): alert table filtered by test_id.</purpose>
      <route>Sheet of the results.xlsx file</route>
      <allowed_roles>user</allowed_roles>
      <navigation>Excel tabs.</navigation>
